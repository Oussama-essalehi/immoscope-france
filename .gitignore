# Local tooling
.claude/

# Data (re-created by `make all`); gold CSVs exceed GitHub's 50 MB limit at national scale
data/raw/*
data/processed/*
data/gold/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/gold/.gitkeep

# Personal interview notes
docs/PERSONAL_NOTES.md

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# Secrets
.env

# Power BI local artefacts
powerbi/**/.pbi/localSettings.json
powerbi/**/.pbi/cache.abf
powerbi/**/.pbi/unappliedChanges.json

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Power BI schema cache (downloaded by src/validate_powerbi.py)
powerbi/.schema_cache/
