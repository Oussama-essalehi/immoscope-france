				            {"est_metropole", type logical},
				            {"latitude", type number},
				            {"longitude", type number},
				            {"niveau_vie_median", type number},
				            {"revenu_menage_median", type number},
				            {"revenu_menage_ville", type number}
				        },
				        "en-US"
				    )
				in
				    TypedColumns

	annotation PBI_ResultType = Table
