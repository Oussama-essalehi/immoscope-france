{
  "name": "DVF Analyse",
  "dataColors": ["#2A78D6", "#EB6834", "#1BAF7A", "#EDA100", "#E87BA4", "#008300", "#6250D6", "#E34948"],
  "foreground": "#0B0B0B",
  "foregroundNeutralSecondary": "#52514E",
  "foregroundNeutralTertiary": "#898781",
  "background": "#FFFFFF",
  "backgroundLight": "#F0EFEC",
  "backgroundNeutral": "#E1E0D9",
  "tableAccent": "#2A78D6",
  "good": "#0CA30C",
  "neutral": "#F0EFEC",
  "bad": "#D03B3B",
  "maximum": "#104281",
  "center": "#F0EFEC",
  "minimum": "#CDE2FB",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#0B0B0B" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0B0B0B" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#0B0B0B" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#52514E" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E1E0D9" } }, "radius": 6 }],
        "padding": [{ "top": 8, "bottom": 8, "left": 8, "right": 8 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#0B0B0B" } }, "fontSize": 12, "bold": true }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#E1E0D9" } }, "gridlineThickness": 1 }],
        "categoryAxis": [{ "gridlineShow": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F9F9F7" } }, "transparency": 0 }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2 }]
      }
    }
  }
}
